class Prime implements Runnable {
    int n = 5;

    public void run() {
        int count = 0;

        for (int i = 1; i <= n; i++) {
            if (n % i == 0)
                count++;
        }

        if (count == 2)
            System.out.println(n + " is Prime");
        else
            System.out.println(n + " is Not Prime");
    }
}

public class Main {
    public static void main(String[] args) {
        Thread t = new Thread(new Prime());
        t.start();
    }
}
