import java.io.*;

public class Main {
    public static void main(String[] args) throws IOException {

        String str = "Computer Science and Engineering";

        
        FileWriter fw = new FileWriter("data.txt");
        fw.write(str);
        fw.close();

        
        FileReader fr = new FileReader("data.txt");
        int ch;

        while ((ch = fr.read()) != -1)
            System.out.print((char) ch);

        fr.close();
    }
}
