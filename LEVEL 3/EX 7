import java.util.*;

class NumberSquare {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter the lower range: ");
        int low = sc.nextInt();

        System.out.print("Enter the upper range: ");
        int high = sc.nextInt();

        System.out.print("[");

        for (int i = low; i <= high; i++) {
            System.out.print("(" + i + ", " + (i * i) + ")");
            if (i < high)
                System.out.print(", ");
        }

        System.out.println("]");
    }
}
