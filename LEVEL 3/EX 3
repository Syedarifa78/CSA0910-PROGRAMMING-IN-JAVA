import java.util.*;

class Factors {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Given Number: ");
        int n = sc.nextInt();

        System.out.print("N = ");
        int k = sc.nextInt();

        int count = 0, nth = 0;

        for (int i = 1; i <= n; i++) {
            if (n % i == 0) {
                count++;
                if (count == k)
                    nth = i;
            }
        }

        System.out.println("Number of factors = " + count);
        System.out.println(k + " th factor of " + n + " = " + nth);
    }
}
