import java.util.*;

class ReduceToZero {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number: ");
        int n = sc.nextInt();
        int steps = 0;

        while (n > 0) {
            if (n % 2 == 0)
                n /= 2;
            else
                n--;

            steps++;
        }

        System.out.println("Number of steps: " + steps);
    }
}
